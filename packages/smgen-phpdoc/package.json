{
  "name": "smgen-phpdoc",
  "version": "0.1.0",
  "description": "Generate linked SMGen API reference pages by statically analyzing PHP source.",
  "keywords": [
    "smgen",
    "phpdoc",
    "php",
    "documentation",
    "static-site-generator"
  ],
  "license": "Apache-2.0",
  "author": "Sean Morris",
  "homepage": "https://github.com/seanmorris/smgen-plugins/tree/main/packages/smgen-phpdoc",
  "bugs": "https://github.com/seanmorris/smgen-plugins/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmorris/smgen-plugins.git",
    "directory": "packages/smgen-phpdoc"
  },
  "type": "module",
  "bin": {
    "smgen-phpdoc": "bin/smgen-phpdoc"
  },
  "smgen": {
    "plugin": "smgen.plugin.yaml"
  },
  "files": [
    "adapter",
    "bin",
    "schemas",
    "src",
    "vendor",
    "composer.json",
    "composer.lock",
    "examples",
    "smgen.plugin.yaml",
    "README.md",
    "BENCHMARKS.md",
    "PROVENANCE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "vendor": "composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader",
    "lint": "php ../../scripts/check-php-docblocks.php adapter && find adapter -type f -name '*.php' -exec php -l {} \\; && eslint bin src tests",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test tests/*.test.js",
    "check": "npm run vendor && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "smgen": ">=0.3.0 <1"
  },
  "peerDependenciesMeta": {
    "smgen": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
