{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanmorris/smgen-plugins/tree/main/packages/smgen-phpdoc/schemas/graph.schema.json",
  "title": "smgen-phpdoc documentation graph version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "diagnostics", "symbols"],
  "properties": {
    "schemaVersion": {"const": 1},
    "package": {
      "type": "object",
      "required": ["title", "description", "version"],
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["file", "startLine", "endLine"],
      "properties": {
        "file": {"type": "string"},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1}
      }
    },
    "type": {
      "type": "object",
      "required": ["display", "references"],
      "properties": {
        "display": {"type": "string"},
        "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "documentation": {
      "type": "object",
      "required": ["summary", "description", "params", "returns", "throws", "var", "deprecated", "see", "tags", "magicMethods", "magicProperties"],
      "properties": {
        "summary": {"type": "string"},
        "description": {"type": "string"},
        "params": {"type": "object"},
        "returns": {"type": ["object", "null"]},
        "throws": {"type": "array"},
        "var": {"type": ["object", "null"]},
        "deprecated": {"type": "string"},
        "see": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array"},
        "magicMethods": {"type": "array"},
        "magicProperties": {"type": "array"}
      }
    },
    "member": {
      "type": "object",
      "required": ["id", "kind", "name", "anchor", "signature", "flags", "type", "returnType", "parameters", "docs", "source", "virtual"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "name": {"type": "string"},
        "anchor": {"type": "string"},
        "signature": {"type": "string"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "type": {"oneOf": [{"$ref": "#/$defs/type"}, {"type": "null"}]},
        "returnType": {"oneOf": [{"$ref": "#/$defs/type"}, {"type": "null"}]},
        "parameters": {"type": "array"},
        "docs": {"$ref": "#/$defs/documentation"},
        "source": {"$ref": "#/$defs/source"},
        "virtual": {"type": "boolean"}
      }
    },
    "symbol": {
      "type": "object",
      "required": ["id", "kind", "name", "shortName", "namespace", "signature", "flags", "attributes", "docs", "extends", "implements", "traits", "members", "source", "conditional"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "name": {"type": "string"},
        "shortName": {"type": "string"},
        "namespace": {"type": "string"},
        "signature": {"type": "string"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "attributes": {"type": "array"},
        "docs": {"$ref": "#/$defs/documentation"},
        "extends": {"type": "array", "items": {"$ref": "#/$defs/type"}},
        "implements": {"type": "array", "items": {"$ref": "#/$defs/type"}},
        "traits": {"type": "array"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "source": {"$ref": "#/$defs/source"},
        "conditional": {"type": "boolean"}
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error"]},
        "code": {"type": "string"},
        "message": {"type": "string"},
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "symbolId": {"type": "string"}
      }
    }
  }
}
