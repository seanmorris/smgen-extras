{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanmorris/smgen-plugins/tree/main/packages/smgen-phpdoc/schemas/config.schema.json",
  "title": "smgen-phpdoc configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "package"],
  "properties": {
    "version": {"const": 1},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "include": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        ]
      }
    },
    "php": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "output": {"type": "string", "minLength": 1},
    "visibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["public", "protected"]}
    },
    "grouping": {"enum": ["namespace", "flat"]},
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overrides": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": ["string", "null"]},
        "parent": {"type": ["string", "null"]},
        "weight": {"type": "number"},
        "symbols": {"type": "boolean"}
      }
    },
    "llms": {
      "oneOf": [
        {"const": false},
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["section"],
          "properties": {
            "section": {"type": "string", "minLength": 1},
            "description": {"type": "string"}
          }
        }
      ]
    },
    "assistant": {"type": "boolean"},
    "jsonld": {"type": "boolean"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string"},
        "ref": {"type": "string"},
        "prefix": {"type": "string"},
        "template": {"type": "string"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summaries": {"$ref": "#/$defs/level"},
        "parameters": {"$ref": "#/$defs/level"},
        "returns": {"$ref": "#/$defs/level"},
        "unresolvedTypes": {"$ref": "#/$defs/level"},
        "brokenSee": {"$ref": "#/$defs/level"}
      }
    },
    "prose": {"enum": ["markdown", "plain"]},
    "cache": {"type": "string", "minLength": 1},
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "landing": {"type": "string"},
        "namespace": {"type": "string"},
        "symbol": {"type": "string"}
      }
    }
  },
  "$defs": {
    "level": {"enum": ["off", "warn", "error"]}
  }
}
