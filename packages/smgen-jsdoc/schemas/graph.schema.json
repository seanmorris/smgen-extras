{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanmorris/smgen-plugins/tree/main/packages/smgen-jsdoc/schemas/graph.schema.json",
  "title": "smgen-jsdoc documentation graph version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "diagnostics", "symbols"],
  "properties": {
    "schemaVersion": {"const": 1},
    "package": {
      "type": "object",
      "required": ["title", "description", "version"],
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "startLine", "endLine"],
      "properties": {
        "file": {"type": "string"},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1}
      }
    },
    "typeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "references"],
      "properties": {
        "display": {"type": "string"},
        "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "documentedType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {"$ref": "#/$defs/typeReference"},
        "description": {"type": "string"}
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "description", "params", "returns", "throws", "deprecated", "see", "examples", "tags"],
      "properties": {
        "summary": {"type": "string"},
        "description": {"type": "string"},
        "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/documentedType"}},
        "returns": {"oneOf": [{"$ref": "#/$defs/documentedType"}, {"type": "null"}]},
        "throws": {"type": "array", "items": {"$ref": "#/$defs/documentedType"}},
        "deprecated": {"type": "string"},
        "see": {"type": "array", "items": {"type": "string"}},
        "examples": {"type": "array", "items": {"type": "string"}},
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {"name": {"type": "string"}, "value": {"type": "string"}}
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "optional", "rest", "defaultValue", "docs"],
      "properties": {
        "name": {"type": "string"},
        "type": {"$ref": "#/$defs/typeReference"},
        "optional": {"type": "boolean"},
        "rest": {"type": "boolean"},
        "defaultValue": {"type": "string"},
        "docs": {"oneOf": [{"$ref": "#/$defs/documentedType"}, {"type": "null"}]}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "anchor", "signature", "flags", "type", "returnType", "parameters", "docs", "source"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["constructor", "method", "property", "getter", "setter"]},
        "name": {"type": "string"},
        "anchor": {"type": "string"},
        "signature": {"type": "string"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "type": {"oneOf": [{"$ref": "#/$defs/typeReference"}, {"type": "null"}]},
        "returnType": {"oneOf": [{"$ref": "#/$defs/typeReference"}, {"type": "null"}]},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
        "docs": {"$ref": "#/$defs/documentation"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "module", "signature", "flags", "type", "returnType", "parameters", "members", "docs", "source"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["class", "function", "constant", "variable", "typedef", "callback"]},
        "name": {"type": "string"},
        "module": {"type": "string"},
        "signature": {"type": "string"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "type": {"oneOf": [{"$ref": "#/$defs/typeReference"}, {"type": "null"}]},
        "returnType": {"oneOf": [{"$ref": "#/$defs/typeReference"}, {"type": "null"}]},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "docs": {"$ref": "#/$defs/documentation"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error"]},
        "code": {"type": "string"},
        "message": {"type": "string"},
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "symbolId": {"type": "string"}
      }
    }
  }
}
