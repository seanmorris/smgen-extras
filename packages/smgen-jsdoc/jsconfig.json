{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": ["bin/**/*.js", "src/**/*.js", "tests/**/*.js"],
  "exclude": ["node_modules", "../../node_modules"]
}
