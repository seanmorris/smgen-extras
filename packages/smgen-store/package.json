{
  "name": "smgen-store",
  "version": "0.1.0",
  "description": "Add validated hosted checkout links and buttons to static SMGen sites.",
  "keywords": [
    "smgen",
    "static-site-generator",
    "ecommerce",
    "checkout"
  ],
  "license": "Apache-2.0",
  "author": "Sean Morris",
  "homepage": "https://github.com/seanmorris/smgen-plugins/tree/main/packages/smgen-store",
  "bugs": "https://github.com/seanmorris/smgen-plugins/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmorris/smgen-plugins.git",
    "directory": "packages/smgen-store"
  },
  "bin": {
    "smgen-store": "bin/smgen-store"
  },
  "smgen": {
    "plugin": "smgen.plugin.yaml"
  },
  "files": [
    "bin",
    "src",
    "filters",
    "static",
    "examples",
    "smgen.plugin.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "php ../../scripts/check-php-docblocks.php . && find bin src tests -type f -name '*.php' -exec php -l {} + && npx eslint static/store.js",
    "test": "php tests/run.php",
    "check": "npm run lint && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "smgen": ">=0.3.0 <1"
  },
  "peerDependenciesMeta": {
    "smgen": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
