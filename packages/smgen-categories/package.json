{
  "name": "smgen-categories",
  "version": "0.1.0",
  "description": "Generate SMGen rollup pages for every value of a frontmatter field, including dates grouped by day, month, or year.",
  "keywords": [
    "smgen",
    "static-site-generator",
    "categories",
    "taxonomy",
    "markdown"
  ],
  "license": "Apache-2.0",
  "author": "Sean Morris",
  "homepage": "https://github.com/seanmorris/smgen-plugins/tree/main/packages/smgen-categories",
  "bugs": "https://github.com/seanmorris/smgen-plugins/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmorris/smgen-plugins.git",
    "directory": "packages/smgen-categories"
  },
  "bin": {
    "smgen-categories": "bin/smgen-categories"
  },
  "smgen": {
    "plugin": "smgen.plugin.yaml"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "examples",
    "smgen.plugin.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "php ../../scripts/check-php-docblocks.php . && find bin src templates tests -type f -name '*.php' -exec php -l {} +",
    "test": "php tests/run.php",
    "check": "npm run lint && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "smgen": ">=0.3.0 <1"
  },
  "peerDependenciesMeta": {
    "smgen": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
