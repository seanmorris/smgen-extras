{
  "name": "smgen-data-pages",
  "version": "0.1.0",
  "description": "Generate SMGen Markdown pages from validated CSV or TSV data.",
  "keywords": [
    "smgen",
    "static-site-generator",
    "csv",
    "markdown"
  ],
  "license": "Apache-2.0",
  "author": "Sean Morris",
  "homepage": "https://github.com/seanmorris/smgen-extras/tree/main/plugins/smgen-data-pages",
  "bugs": "https://github.com/seanmorris/smgen-extras/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmorris/smgen-extras.git",
    "directory": "plugins/smgen-data-pages"
  },
  "bin": {
    "smgen-data-pages": "bin/smgen-data-pages"
  },
  "smgen": {
    "plugin": "smgen.plugin.yaml"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "smgen.plugin.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "php ../../scripts/check-php-docblocks.php . && find bin src tests -type f -name '*.php' -exec php -l {} +",
    "test": "php tests/run.php",
    "check": "npm run lint && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "smgen": ">=0.3.0 <1"
  },
  "peerDependenciesMeta": {
    "smgen": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
