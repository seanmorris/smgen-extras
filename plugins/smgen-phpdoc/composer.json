{
  "name": "seanmorris/smgen-phpdoc-adapter",
  "description": "Bundled static PHP parser for smgen-phpdoc.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "nikic/php-parser": "5.9.0",
    "phpstan/phpdoc-parser": "2.3.8"
  },
  "autoload": {
    "psr-4": {
      "SmgenPhpDoc\\": "adapter/src/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
